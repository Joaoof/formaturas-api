# Copie para .env.hml na VPS e preencha. Nunca commite o arquivo real.
# Este ambiente e ISOLADO de producao: banco, porta e segredos proprios.

POSTGRES_DB=formaturas_hml
POSTGRES_USER=formaturas_hml
POSTGRES_PASSWORD=troque_esta_senha_forte_de_hml

JWT_ISSUER=http://191.101.78.252:8081
JWT_AUDIENCE=formaturasflow-front-hml
JWT_KEY=troque_por_uma_chave_de_pelo_menos_32_bytes_so_de_hml
JWT_ACCESS_TOKEN_MINUTES=60

# Asaas sandbox — pegue em https://sandbox.asaas.com (Integracoes > API)
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=hml-webhook-secret

# Cora stage — credencial mTLS baixada no painel da Cora
#   (Conta > Integracoes via APIs > Integracao Direta > Ambiente de teste)
#
# A Cora entrega DOIS arquivos, certificate.pem e private-key.key.  Gere o
# valor de cada um assim, na maquina onde eles estao:
#   base64 -w0 certificate.pem
#   base64 -w0 private-key.key
CORA_CERTIFICATE_PEM=
CORA_PRIVATE_KEY_PEM=

# Deixe VAZIO: o client_id e lido do CN do proprio certificado, o que
# evita subir o certificado de producao com o identificador de teste.
CORA_CLIENT_ID=

# Alternativa, so se voce converteu a credencial para .pfx:
#   base64 -w0 certificado.p12
CORA_CERTIFICATE_BASE64=
CORA_CERTIFICATE_PASSWORD=

# OBRIGATORIO.  O webhook e anonimo e cada POST aceito dispara uma chamada
# autenticada a Cora, entao sem segredo ele vira amplificador de trafego.
# Gere um forte:  openssl rand -base64 32
CORA_WEBHOOK_SECRET=

# Origem do front que vai bater nesta homologacao
CORS_ORIGIN_0=http://localhost:5173
